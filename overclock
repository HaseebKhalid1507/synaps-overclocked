#!/usr/bin/env bash
# overclock: turn stock SynapsCLI into the synaps-overclocked stack.
#   overclock [install|status|update|uninstall] [--dry-run] [--reclone] [--replace-foreign] [--profile NAME]
# Portable to bash 3.2 (macOS): no mapfile/assoc arrays, empty arrays expanded via ${a[@]+"${a[@]}"}.
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
MARKETPLACE_NAME="synaps-overclocked"
MARKETPLACE_REPO="https://github.com/HaseebKhalid1507/synaps-overclocked"
MARKETPLACE_URL="https://raw.githubusercontent.com/HaseebKhalid1507/synaps-overclocked/HEAD/.synaps-plugin/marketplace.json"
MANIFEST="$SELF_DIR/.synaps-plugin/marketplace.json"
SUBDIR_PLUGINS="$SELF_DIR/subdir-plugins.json"
LOCK="$SELF_DIR/skills.lock.json"
MCP_TEMPLATE="$SELF_DIR/mcp/context-mode.json"

# ---------- output ----------
if [ -t 1 ]; then C_R=$'\e[31m' C_G=$'\e[32m' C_Y=$'\e[33m' C_B=$'\e[1m' C_0=$'\e[0m'; else C_R='' C_G='' C_Y='' C_B='' C_0=''; fi
say()  { printf '%s\n' "$*"; }
head1(){ printf '\n%s== %s ==%s\n' "$C_B" "$*" "$C_0"; }
ok()   { printf '  %s✓%s %s\n' "$C_G" "$C_0" "$*"; }
skip() { printf '  %s-%s %s\n' "$C_Y" "$C_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_Y" "$C_0" "$*" >&2; }
die()  { printf '%soverclock: %s%s\n' "$C_R" "$*" "$C_0" >&2; exit 1; }
dry()  { printf '  [dry-run] %s\n' "$*"; }

usage() {
  cat <<EOF
usage: overclock [install|status|update|uninstall] [--dry-run] [--reclone] [--replace-foreign] [--profile NAME]

  install    (default) install everything that is missing; existing items are skipped
  status     show each item: installed / skipped (foreign) / missing, commit vs pinned
  update     fast-forward the plugins; bump skills/context-mode when skills.lock.json changes
  uninstall  move everything overclock installed to <base>/overclocked/removed/ and
             drop its entries from plugins.json / mcp.json

  --dry-run          print every action, write nothing
  --reclone          items overclock owns only: install reclones its plugins and
                     refreshes locally modified agents; update reclones plugins that
                     cannot fast-forward (rewritten upstream) or have local changes
  --replace-foreign  move items overclock did NOT install (dirs, dev symlinks, a
                     different context-mode mcp entry) aside and install ours;
                     uninstall puts them back
  --force            deprecated alias for --reclone
  --profile          Synaps profile (default: \$SYNAPS_PROFILE)

Replaced items go to <base>/overclocked/backups/<ts>/, never deleted.
Base dir: \$SYNAPS_BASE_DIR or ~/.synaps-cli
EOF
}

CMD=install DRY=0 RECLONE=0 REPLACE=0 PROFILE="${SYNAPS_PROFILE:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    install|status|update|uninstall) CMD="$1" ;;
    --dry-run) DRY=1 ;;
    --reclone) RECLONE=1 ;;
    --replace-foreign) REPLACE=1 ;;
    --force) RECLONE=1; echo "overclock: --force is deprecated; it now means --reclone (owned items only). Use --replace-foreign to replace items overclock didn't install." >&2 ;;
    --profile)
      if [ $# -lt 2 ] || [ -z "$2" ] || [ "${2#-}" != "$2" ]; then die "--profile needs a profile name"; fi
      shift; PROFILE="$1" ;;
    --profile=*) PROFILE="${1#--profile=}"; [ -n "$PROFILE" ] || die "--profile needs a profile name" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "overclock: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

# ---------- guards ----------
if [ "$(id -u)" -eq 0 ]; then die "refusing to run as root"; fi
command -v git >/dev/null 2>&1 || die "git is required"
command -v jq  >/dev/null 2>&1 || die "jq is required"
export GIT_TERMINAL_PROMPT=0   # a missing/private repo must fail, not prompt for credentials
[ -f "$MANIFEST" ] && [ -f "$SUBDIR_PLUGINS" ] && [ -f "$LOCK" ] && [ -f "$MCP_TEMPLATE" ] || die "run overclock from a synaps-overclocked checkout ($SELF_DIR is incomplete)"

if [ -n "${SYNAPS_BASE_DIR:-}" ]; then BASE="$SYNAPS_BASE_DIR"
elif [ -n "${HOME:-}" ]; then BASE="$HOME/.synaps-cli"
else die "neither SYNAPS_BASE_DIR nor HOME is set"; fi
case "$BASE" in /*) ;; *) die "base dir must be absolute: $BASE" ;; esac
while [ "${BASE%/}" != "$BASE" ]; do BASE="${BASE%/}"; done
[ -n "$BASE" ] || die "refusing to use / as the Synaps base dir"
case "$BASE/" in */../*|*/./*) die "base dir must not contain . or .. components: $BASE" ;; esac
if [ -n "$PROFILE" ]; then
  case "$PROFILE" in */*|.|..) die "invalid profile name: $PROFILE" ;; esac
fi

# Path resolution mirrors agent-core config.rs:
#   plugins.json -> resolve_write_path   (profile dir if a profile is active)
#   mcp.json     -> resolve_read_path    (profile file if it exists, else base)
#   skills/      -> resolve_read_path_extended (profile dir if it exists, else base)
#   plugins/     -> base_dir()/plugins   (extension manager only loads from here)
#   agents/      -> base_dir()/agents    (tools/agent.rs)
PDIR="$BASE${PROFILE:+/$PROFILE}"
PSTATE="$PDIR/plugins.json"
if [ -n "$PROFILE" ] && [ -e "$PDIR/mcp.json" ]; then MCP_FILE="$PDIR/mcp.json"; else MCP_FILE="$BASE/mcp.json"; fi
if [ -n "$PROFILE" ] && [ -d "$PDIR/skills" ]; then SKILLS_DIR="$PDIR/skills"; else SKILLS_DIR="$BASE/skills"; fi
PLUGINS_DIR="$BASE/plugins"
AGENTS_DIR="$BASE/agents"
OC_DIR="$BASE/overclocked"          # not a Synaps discovery root: safe for backups/clones
OC_STATE="$OC_DIR/state.json"
CM_DIR="$OC_DIR/context-mode"
TS="$(date +%Y%m%d%H%M%S)"
NOW="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"

have() { command -v "$1" >/dev/null 2>&1; }
in_list() { local x="$1" y; shift; for y in "$@"; do if [ "$x" = "$y" ]; then return 0; fi; done; return 1; }
short() { printf '%s' "${1:0:7}"; }
exists() { [ -e "$1" ] || [ -L "$1" ]; }
gitq() { local d="$1"; shift; GIT_OPTIONAL_LOCKS=0 git -C "$d" "$@"; }
head_of() { gitq "$1" rev-parse HEAD 2>/dev/null || true; }
is_dirty() { [ -n "$(gitq "$1" status --porcelain --untracked-files=no 2>/dev/null)" ]; }
sha256() { if have sha256sum; then sha256sum | cut -d' ' -f1; else shasum -a 256 | cut -d' ' -f1; fi; }
norm_url() { local u="$1"; while [ "${u%/}" != "$u" ]; do u="${u%/}"; done; u="${u%.git}"; printf '%s' "$u" | tr '[:upper:]' '[:lower:]'; }
rel_of() { case "$1" in "$BASE"/*) printf '%s' "${1#"$BASE"/}" ;; *) printf 'external/%s' "$(basename "$1")" ;; esac; }
# A path overclock may record or move: strictly under $BASE, no . or .. components.
safe_path() { case "$1/" in "$BASE"/?*) ;; *) return 1 ;; esac; case "$1/" in */../*|*/./*) return 1 ;; esac; return 0; }
# Clean clone: nothing modified/untracked and no commits ahead of its upstream.
is_pristine() {
  [ -z "$(gitq "$1" status --porcelain 2>/dev/null)" ] || return 1
  if gitq "$1" rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
    [ "$(gitq "$1" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 1)" = 0 ] || return 1
  fi
  return 0
}
file_mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }

# Every JSON write: tmp file in the same dir, then rename. Never through a symlink.
# Existing files keep their mode; new files stay 0600 (mktemp default).
write_json() { # <file> <json>
  local f="$1" tmp
  if [ -L "$f" ]; then die "internal: refusing to write through symlink $f"; fi
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp "$f.overclock-tmp.XXXXXX")"
  printf '%s\n' "$2" >"$tmp"
  if [ -f "$f" ]; then chmod --reference="$f" "$tmp" 2>/dev/null || chmod "$(file_mode "$f")" "$tmp"; fi
  mv -f "$tmp" "$f"
}

# ---------- backups: all under $OC_DIR/backups/<ts>[-pid]/<path relative to base> ----------
BK_DIR=""
bk_root() {
  if [ -n "$BK_DIR" ]; then return 0; fi
  BK_DIR="$OC_DIR/backups/$TS"
  if exists "$BK_DIR"; then BK_DIR="$BK_DIR-$$"; fi
}
bk_dest() { # <path> -> sets BK_DEST
  bk_root
  BK_DEST="$BK_DIR/$(rel_of "$1")"
  local i=1
  while exists "$BK_DEST"; do BK_DEST="$BK_DIR/$(rel_of "$1").$i"; i=$((i + 1)); done
}
backup_file() { # copy (not move) a JSON file before rewriting it
  [ -f "$1" ] || return 0
  bk_dest "$1"
  mkdir -p "$(dirname "$BK_DEST")"
  cp -p "$1" "$BK_DEST"
  ok "backup: $BK_DEST"
}
move_aside() { # <path>   never rm user data; moved out of every scanned tree
  bk_dest "$1"
  if [ "$DRY" = 1 ]; then dry "mv $1 -> $BK_DEST"; return 0; fi
  mkdir -p "$(dirname "$BK_DEST")"
  mv "$1" "$BK_DEST"
  ok "moved aside: $BK_DEST"
}

# ---------- overclock state (ownership record) ----------
# $OC_DIR/state.json:
#   {"version":1, "profile":"", "plugins_json":..., "mcp_json":...,      <- recorded on first write
#    "items":{"<kind>:<name>":{"path":...,...}},                         <- what we installed
#    "added_marketplace":bool, "added_trusted_hosts":[...],              <- what we added to plugins.json
#    "displaced":[{"path","backup","link"?} | {"mcp_file","entry"}]}     <- foreign items --replace-foreign moved
state_json() { if [ -f "$OC_STATE" ]; then cat "$OC_STATE"; else echo '{"version":1,"items":{}}'; fi; }
owned() { state_json | jq -e --arg k "$1" '.items[$k] != null' >/dev/null; }
state_update() { # <jq filter> [jq args...]   meta recorded on first write
  if [ "$DRY" = 1 ]; then return 0; fi
  local f="$1" new; shift
  new="$(state_json | jq --arg prof "$PROFILE" --arg pj "$PSTATE" --arg mj "$MCP_FILE" "$@" \
    "(if has(\"profile\") then . else .profile = \$prof | .plugins_json = \$pj | .mcp_json = \$mj end) | $f")"
  write_json "$OC_STATE" "$new"
}
state_set() { # <key> <json object>
  local p; p="$(jq -r '.path // empty' <<<"$2")"
  if [ -n "$p" ] && ! safe_path "$p"; then die "internal: refusing to record unsafe path $p"; fi
  state_update '.items[$k] = $v' --arg k "$1" --argjson v "$2"
}
state_merge() { # <key> <json object merged into the existing item>
  state_update '.items[$k] = ((.items[$k] // {}) + $v)' --arg k "$1" --argjson v "$2"
}
# warn once if this run's profile differs from the one state.json was recorded under
check_recorded_profile() {
  [ -f "$OC_STATE" ] || return 0
  local rp; rp="$(jq -r 'if has("profile") then .profile else "<none>" end' "$OC_STATE")"
  if [ "$rp" != "<none>" ] && [ "$rp" != "$PROFILE" ]; then
    warn "state.json was recorded under profile '${rp:-<default>}' but this run uses '${PROFILE:-<default>}'"
    if [ "$CMD" = uninstall ]; then warn "  uninstall follows the recorded profile"; else warn "  uninstall will only clean the recorded profile's plugins.json"; fi
  fi
}

# Move a FOREIGN item aside (--replace-foreign) and remember it so uninstall can put it back.
displace() { # <path>
  local link=""
  if [ -L "$1" ]; then link="$(readlink "$1")"; fi
  move_aside "$1"
  state_update '.displaced = ((.displaced // []) + [{path:$p, backup:$b, link:(if $l == "" then null else $l end), at:$t}])' \
    --arg p "$1" --arg b "$BK_DEST" --arg l "$link" --arg t "$NOW"
}

# ---------- preflight: validate JSON we may merge into ----------
validate_json_files() {
  if [ -e "$PSTATE" ]; then
    jq -e 'type == "object"
      and ((.marketplaces // []) | type == "array")
      and ((.installed // []) | type == "array")
      and ((.trusted_hosts // []) | type == "array")' "$PSTATE" >/dev/null 2>&1 \
      || die "$PSTATE is not valid plugins.json (invalid JSON or wrong shape); aborting without writing anything"
  fi
  if [ -e "$MCP_FILE" ]; then
    jq -e 'type == "object" and ((.mcpServers // {}) | type == "object")' "$MCP_FILE" >/dev/null 2>&1 \
      || die "$MCP_FILE is not valid mcp.json (invalid JSON or wrong shape); aborting without writing anything"
  fi
  if [ -e "$OC_STATE" ]; then
    jq -e '.items | type == "object"' "$OC_STATE" >/dev/null 2>&1 || die "$OC_STATE is corrupt; aborting"
    if [ -L "$OC_STATE" ]; then die "$OC_STATE is a symlink; aborting"; fi
  fi
  return 0
}

check_runtimes() {
  local r
  for r in python3 bun node cargo; do
    have "$r" || warn "$r not found: items that need it will be skipped"
  done
}

# Pinned clone: git init + fetch exactly <commit>, verify HEAD.
clone_pinned() { # <repo> <commit> <dest>
  git init -q "$3"
  git -C "$3" remote add origin "$1"
  git -C "$3" fetch -q --depth=1 origin "$2"
  git -C "$3" -c advice.detachedHead=false checkout -q FETCH_HEAD
  [ "$(git -C "$3" rev-parse HEAD)" = "$2" ] || die "pinned clone of $1 did not land on $2"
}

# Scratch space on the same filesystem as $BASE so the final step is a rename.
TMPROOT=""
init_tmp() {
  mkdir -p "$OC_DIR"
  TMPROOT="$(mktemp -d "$OC_DIR/.tmp.XXXXXX")"
  trap 'rm -rf "$TMPROOT"' EXIT   # our own scratch dir only
}
tmpdir() { [ -n "$TMPROOT" ] || die "internal: scratch dir not initialised"; mktemp -d "$TMPROOT/x.XXXXXX"; }

# ======================================================================
# plugins
# ======================================================================
# Two sources: whole-repo plugins from .synaps-plugin/marketplace.json, and plugins that
# live in a subdirectory of someone else's repo (subdir-plugins.json).
PLUGIN_NAMES=() ; while IFS= read -r n; do PLUGIN_NAMES+=("$n"); done < <(jq -r '.plugins[].name' "$MANIFEST" "$SUBDIR_PLUGINS")
plugin_field() { jq -rn --arg n "$1" --arg f "$2" '[inputs.plugins[] | select(.name == $n) | .[$f] // empty][0] // empty' "$MANIFEST" "$SUBDIR_PLUGINS"; }
plugin_src() { plugin_field "$1" source; }
plugin_subdir() { plugin_field "$1" subdir; }
# What a plugin needs before it is worth cloning. The plugin repos' manifests declare
# python3/bun; crush is a Rust binary that has to be built; tmux-tools is skills only.
plugin_needs() { case "$1" in synaps-dash) echo bun ;; crush) echo cargo ;; tmux-tools) echo "" ;; *) echo python3 ;; esac; }
plugin_builds() { [ "$(plugin_needs "$1")" = cargo ]; }
need_hint() { case "$1" in cargo) printf ' (it is built from source; install the Rust toolchain: https://rustup.rs)' ;; esac; }
# Same rule as the native installer (marketplace.rs is_safe_plugin_name): one path component.
safe_subdir() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_-]{1,64}$'; }
# A plugin dir overclock manages: a git clone, or (subdir plugins) a plain copied dir.
# HEAD of a cloned plugin; the recorded commit for a copied subdir plugin.
plugin_commit() { if [ -n "$(plugin_subdir "$1")" ]; then state_json | jq -r --arg k "plugin:$1" '.items[$k].commit // empty'; else head_of "$2"; fi; }
managed_dir() { [ ! -L "$2" ] || return 1; if [ -n "$(plugin_subdir "$1")" ]; then [ -d "$2" ]; else [ -d "$2/.git" ]; fi; }

# extension.command from the cloned manifest. Bare names must be on PATH;
# paths are relative to the plugin dir (post_install.rs verify_extension_command).
plugin_command_ok() { # <name> <plugin dir>
  local cmd
  cmd="$(jq -r '.extension.command // empty' "$2/.synaps-plugin/plugin.json" 2>/dev/null || true)"
  case "$cmd" in
    "") return 0 ;;
    /*) warn "$1: extension.command is absolute ($cmd); Synaps will refuse to start it"; return 0 ;;
    */*) [ -e "$2/$cmd" ] || warn "$1: $cmd not present in the plugin dir yet (it may need a build/setup step)"; return 0 ;;
    *) have "$cmd" && return 0; warn "$1: skipped, needs '$cmd' which is not installed"; return 1 ;;
  esac
}
origin_matches() { # <dir> <source url>
  local u
  [ -d "$1/.git" ] && [ ! -L "$1" ] || return 1
  u="$(gitq "$1" remote get-url origin 2>/dev/null)" || return 1
  [ "$(norm_url "$u")" = "$(norm_url "$2")" ]
}
plugin_state() { # <name> <path> <commit> [extra json merged in]
  local x="${4:-}"; [ -n "$x" ] || x='{}'
  jq -n --arg p "$2" --arg c "$3" --arg s "$(plugin_src "$1")" --arg t "$NOW" --argjson x "$x" \
    '{path:$p,commit:$c,source:$s,installed_at:$t} + $x'
}

# Content hash of a copied (non-git) plugin dir: paths, contents, exec bits, link targets.
# Recorded at install so update can tell local edits apart from upstream changes.
tree_sum() {
  ( cd "$1" && find . \( -type f -o -type l \) -print | LC_ALL=C sort | while IFS= read -r f; do
      if [ -L "$f" ]; then printf 'l %s %s\n' "$f" "$(readlink "$f")"
      else printf 'f %s %s %s\n' "$f" "$([ -x "$f" ] && echo x || echo -)" "$(sha256 <"$f")"; fi
    done ) | sha256
}

# Subdir plugin, mirroring install.rs install_plugin_from_subdir (shallow clone of the
# repo, then <subdir> moved into place) but sparse: only <subdir> is checked out.
# <work>/src is the checkout, <work>/out the plugin dir. <ref> is HEAD or a commit.
stage_subdir() { # <src> <subdir> <ref> <work>
  safe_subdir "$2" || { echo "unsafe subdir name: $2"; return 1; }
  git init -q "$4/src" &&
    git -C "$4/src" remote add origin "$1" &&
    git -C "$4/src" config core.sparseCheckout true &&
    printf '/%s/\n' "$2" >"$4/src/.git/info/sparse-checkout" &&
    git -C "$4/src" fetch -q --depth=1 --filter=blob:none origin "$3" 2>&1 | grep -v 'filtering not recognized by server' >&2
  [ "${PIPESTATUS[0]}" = 0 ] || return 1
  git -C "$4/src" -c advice.detachedHead=false checkout -q FETCH_HEAD || return 1
  if [ ! -d "$4/src/$2" ] || [ -L "$4/src/$2" ]; then echo "subdir '$2' not found in $1"; return 1; fi
  mv "$4/src/$2" "$4/out"
}

# crush: cargo build --release --locked, then the manifest's command must exist.
# Log goes to $OC_DIR/logs/; the path is recorded as setup_status like /plugins does.
SETUP_LOG=""
build_plugin() { # <name> <plugin dir>
  local n="$1" d="$2" log cmd
  if [ ! -f "$d/Cargo.lock" ]; then warn "$n: no Cargo.lock in the source; refusing an unlocked build"; return 1; fi
  mkdir -p "$OC_DIR/logs"
  log="$OC_DIR/logs/$n-$TS.log"
  say "  … $n: cargo build --release --locked (log: $log)"
  if ! (cd "$d" && cargo build --release --locked) >"$log" 2>&1; then
    warn "$n: cargo build failed: $(tail -n 3 "$log" | tr '\n' ' ')"
    warn "  full log: $log"
    return 1
  fi
  cmd="$(jq -r '.extension.command // empty' "$d/.synaps-plugin/plugin.json" 2>/dev/null || true)"
  case "$cmd" in
    /*) warn "$n: extension.command is absolute ($cmd); not registering it"; return 1 ;;
    */*) if [ ! -x "$d/$cmd" ]; then warn "$n: build finished but $cmd is missing or not executable (log: $log)"; return 1; fi ;;
  esac
  SETUP_LOG="$log"
}
setup_status_json() { if [ -n "$SETUP_LOG" ]; then jq -cn --arg l "$SETUP_LOG" '{state:"succeeded",log_path:$l}'; else echo '{"state":"not_required"}'; fi; }

FRESH_PLUGINS=()   # (re)cloned or fast-forwarded this run -> commit refreshed in plugins.json
OWNED_PLUGINS=()   # managed by overclock -> entry ensured in plugins.json

# Fresh clone (and build) into scratch, then swap in. An owned old dir goes to backups;
# a foreign one (--replace-foreign) is displaced so uninstall can restore it.
# Anything that fails before the swap leaves the existing dir alone.
reclone_plugin() { # <name> [foreign]
  local n="$1" dest="$PLUGINS_DIR/$1" foreign="${2:-}" src sub need work tmp sha err extra
  src="$(plugin_src "$n")"; sub="$(plugin_subdir "$n")"; need="$(plugin_needs "$n")"
  if plugin_builds "$n" && ! have "$need"; then warn "$n: skipped, needs '$need' which is not installed$(need_hint "$need")"; return 1; fi
  if [ "$DRY" = 1 ]; then
    if exists "$dest"; then if [ -n "$foreign" ]; then displace "$dest"; else move_aside "$dest"; fi; fi
    if [ -n "$sub" ]; then dry "sparse clone --depth=1 $src, copy $sub/ -> $dest"
    else dry "git clone --depth=1 $src $dest"; fi
    if plugin_builds "$n"; then dry "(cd $dest && cargo build --release --locked)"; fi
    dry "record $n in $PSTATE (marketplace $MARKETPLACE_NAME${sub:+, source_subdir $sub})"
    return 0
  fi
  work="$(tmpdir)"; SETUP_LOG=""
  if [ -n "$sub" ]; then
    if ! err="$(stage_subdir "$src" "$sub" HEAD "$work" 2>&1)"; then warn "$n: fetching $sub from $src failed: $err"; return 1; fi
    tmp="$work/out"; sha="$(git -C "$work/src" rev-parse HEAD)"
    extra="$(jq -cn --arg s "$sub" --arg h "$(tree_sum "$tmp")" '{subdir:$s, tree:$h}')"
  else
    tmp="$work/$n"
    if ! err="$(git clone -q --depth=1 "$src" "$tmp" 2>&1)"; then warn "$n: git clone failed: $err"; return 1; fi
    sha="$(git -C "$tmp" rev-parse HEAD)"
    if plugin_builds "$n"; then build_plugin "$n" "$tmp" || { warn "$n: not installed"; return 1; }; fi
    extra="$(jq -cn --argjson st "$(setup_status_json)" '{setup_status:$st}')"
  fi
  plugin_command_ok "$n" "$tmp" || return 1
  mkdir -p "$PLUGINS_DIR"
  if exists "$dest"; then if [ -n "$foreign" ]; then displace "$dest"; else move_aside "$dest"; fi; fi
  mv "$tmp" "$dest"
  state_set "plugin:$n" "$(plugin_state "$n" "$dest" "$sha" "$extra")"
  ok "$n: $( [ -n "$sub" ] && echo "copied $sub/" || echo cloned) @ $(short "$sha")$( [ -n "$SETUP_LOG" ] && echo ", built")"
  FRESH_PLUGINS+=("$n")
}

# A subdir plugin installed by /plugins: plugins.json says it came from the same repo +
# subdir, and its content is exactly that subdir at the recorded commit.
adopt_subdir_plugin() { # <name> <dest> -> 0 if adopted
  local n="$1" dest="$2" src sub row u c work
  src="$(plugin_src "$n")"; sub="$(plugin_subdir "$n")"
  [ -f "$PSTATE" ] && [ ! -L "$dest" ] && [ -d "$dest" ] || return 1
  row="$(jq -r --arg n "$n" --arg s "$sub" '[.installed[]? | select(.name == $n and .source_subdir == $s)][0] // empty | "\(.source_url)\t\(.installed_commit)"' "$PSTATE" 2>/dev/null)"
  [ -n "$row" ] || return 1
  u="${row%%$'\t'*}"; c="${row#*$'\t'}"
  [ "$(norm_url "$u")" = "$(norm_url "$src")" ] || return 1
  printf '%s' "$c" | grep -Eq '^[0-9a-f]{40}$' || return 1
  if [ "$DRY" = 1 ]; then dry "adopt $dest if it matches $sub/ of $src @ $(short "$c")"; return 0; fi
  work="$(tmpdir)"
  stage_subdir "$src" "$sub" "$c" "$work" >/dev/null 2>&1 || return 1
  [ "$(tree_sum "$work/out")" = "$(tree_sum "$dest")" ] || return 1
  state_set "plugin:$n" "$(plugin_state "$n" "$dest" "$c" "$(jq -cn --arg s "$sub" --arg h "$(tree_sum "$dest")" '{subdir:$s, tree:$h}')")"
  ok "$n: adopted existing install ($sub/ @ $(short "$c"))"
}

install_plugins() {
  head1 "plugins → $PLUGINS_DIR"
  local n dest src sub need
  for n in ${PLUGIN_NAMES[@]+"${PLUGIN_NAMES[@]}"}; do
    dest="$PLUGINS_DIR/$n"; src="$(plugin_src "$n")"; sub="$(plugin_subdir "$n")"; need="$(plugin_needs "$n")"
    if [ -n "$sub" ] && ! safe_subdir "$sub"; then warn "$n: unsafe subdir '$sub' in subdir-plugins.json; skipped"; continue; fi
    # adopt: a real, clean install of the same source (interrupted run, or a /plugins TUI install)
    if exists "$dest" && [ ! -L "$dest" ] && ! owned "plugin:$n"; then
      if [ -n "$sub" ]; then
        if adopt_subdir_plugin "$n" "$dest"; then
          OWNED_PLUGINS+=("$n")
          [ "$RECLONE" = 1 ] || continue
        fi
      elif origin_matches "$dest" "$src"; then
        if is_pristine "$dest"; then
          if [ "$DRY" = 1 ]; then dry "adopt $dest (origin matches $src, clean)"
          else state_set "plugin:$n" "$(plugin_state "$n" "$dest" "$(head_of "$dest")")"; ok "$n: adopted existing clone @ $(short "$(head_of "$dest")")"; fi
          OWNED_PLUGINS+=("$n")
          [ "$RECLONE" = 1 ] || continue
        else
          skip "$n: $dest is a clone of $src with local changes or unpushed commits; treating it as foreign"
        fi
      fi
    fi
    if exists "$dest"; then
      if owned "plugin:$n" && managed_dir "$n" "$dest"; then
        if [ "$RECLONE" = 0 ]; then ok "$n: installed @ $(short "$(plugin_commit "$n" "$dest")")"
        else reclone_plugin "$n" || true; fi
        in_list "$n" ${OWNED_PLUGINS[@]+"${OWNED_PLUGINS[@]}"} || OWNED_PLUGINS+=("$n")
        continue
      fi
      if [ "$REPLACE" = 0 ]; then
        skip "$n: skipped, $dest exists$([ -L "$dest" ] && echo " (symlink → $(readlink "$dest"))") and is not managed by overclock (use --replace-foreign to replace it)"
        continue
      fi
    fi
    if [ -n "$need" ] && ! have "$need"; then warn "$n: skipped, needs '$need' which is not installed$(need_hint "$need")"; continue; fi
    if reclone_plugin "$n" foreign && [ "$DRY" = 0 ]; then OWNED_PLUGINS+=("$n"); fi
  done
}

# Merge plugins.json the way the /plugins TUI would have written it
# (state.rs PluginsState / InstalledPlugin; actions.rs record_installed_plugin / apply_confirm_pending_update).
merge_plugins_json() {
  head1 "plugins.json → $PSTATE"
  if [ "${#OWNED_PLUGINS[@]}" -eq 0 ]; then skip "no managed plugins installed yet; leaving plugins.json alone"; return 0; fi
  if [ -L "$PSTATE" ]; then warn "$PSTATE is a symlink; not rewriting it (Synaps would lose the link). Register the plugins via /plugins instead."; return 0; fi
  local cur new entries="[]" n sha fresh setup
  cur="$( [ -f "$PSTATE" ] && cat "$PSTATE" || echo '{}')"
  for n in ${OWNED_PLUGINS[@]+"${OWNED_PLUGINS[@]}"}; do
    sha="$(plugin_commit "$n" "$PLUGINS_DIR/$n")"
    [ -n "$sha" ] || continue
    if in_list "$n" ${FRESH_PLUGINS[@]+"${FRESH_PLUGINS[@]}"}; then fresh=true; else fresh=false; fi
    setup="$(state_json | jq -c --arg k "plugin:$n" '.items[$k].setup_status // {state:"not_required"}')"
    # subdir plugins: source_url is the repo, source_subdir the dir inside it (state.rs InstalledPlugin)
    entries="$(jq --arg n "$n" --arg m "$MARKETPLACE_NAME" --arg s "$(plugin_src "$n")" --arg sub "$(plugin_subdir "$n")" \
      --arg c "$sha" --arg t "$NOW" --argjson fresh "$fresh" --argjson st "$setup" \
      '. + [{fresh:$fresh, entry:{name:$n, marketplace:$m, source_url:$s, installed_commit:$c, latest_commit:null,
             installed_at:$t, source_subdir:(if $sub == "" then null else $sub end), checksum_algorithm:null, checksum_value:null,
             setup_status:$st}}]' <<<"$entries")"
  done
  new="$(jq --argjson e "$entries" --slurpfile mp "$MANIFEST" \
    --arg mn "$MARKETPLACE_NAME" --arg url "$MARKETPLACE_URL" --arg repo "$MARKETPLACE_REPO.git" --arg t "$NOW" '
    .marketplaces = (.marketplaces // []) | .installed = (.installed // []) | .trusted_hosts = (.trusted_hosts // [])
    | if any(.marketplaces[]; .name == $mn) then . else
        .marketplaces += [{name:$mn, url:$url, description:$mp[0].description, last_refreshed:$t,
          cached_plugins:[$mp[0].plugins[] | {name, source, version, description, index:null}], repo_url:$repo}]
      end
    | reduce $e[] as $x (.;
        if any(.installed[]; .name == $x.entry.name) then
          (if $x.fresh then .installed |= map(if .name == $x.entry.name
              then . + ($x.entry | {marketplace, source_url, installed_commit, latest_commit, source_subdir, setup_status}) else . end)
           else . end)
        else .installed += [$x.entry] end)
    | reduce ($e[] | .entry.source_url | capture("^https://(?<h>[^/]+)/(?<o>[^/]+)/") | "\(.h)/\(.o)") as $h (.;
        if any(.trusted_hosts[]; . == $h) then . else .trusted_hosts += [$h] end)
  ' <<<"$cur")"
  if [ -f "$PSTATE" ] && [ "$(jq -S . "$PSTATE")" = "$(jq -S . <<<"$new")" ]; then ok "up to date"; return 0; fi
  if [ "$DRY" = 1 ]; then
    dry "merge into $PSTATE: installed=[${OWNED_PLUGINS[*]+"${OWNED_PLUGINS[*]}"}] marketplace=$MARKETPLACE_NAME (existing entries preserved)"
    return 0
  fi
  backup_file "$PSTATE"
  write_json "$PSTATE" "$new"
  # remember exactly what we added, so uninstall removes only that
  state_update '(if $mp_added then .added_marketplace = true else . end)
      | .added_trusted_hosts = (((.added_trusted_hosts // []) + $hosts) | unique)' \
    --argjson mp_added "$(jq --arg mn "$MARKETPLACE_NAME" 'any((.marketplaces // [])[]; .name == $mn) | not' <<<"$cur")" \
    --argjson hosts "$(jq -n --argjson a "$cur" --argjson b "$new" '($b.trusted_hosts // []) - ($a.trusted_hosts // [])')"
  ok "merged ($(jq '.installed | length' <<<"$new") installed, $(jq '.marketplaces | length' <<<"$new") marketplaces)"
}

# ======================================================================
# agents
# ======================================================================
install_agents() {
  head1 "agents → $AGENTS_DIR"
  local f n dest sum
  for f in "$SELF_DIR"/agents/*.md; do
    n="$(basename "$f" .md)"; dest="$AGENTS_DIR/$n.md"; sum="$(sha256 <"$f")"
    if exists "$dest"; then
      if owned "agent:$n" && [ ! -L "$dest" ]; then
        if [ "$(sha256 <"$dest")" = "$sum" ]; then ok "$n: installed"; continue; fi
        if [ "$RECLONE" = 0 ]; then skip "$n: installed but locally modified (left alone; --reclone refreshes it)"; continue; fi
        move_aside "$dest"
      elif [ "$REPLACE" = 0 ]; then skip "$n: skipped, $dest exists and is not managed by overclock (use --replace-foreign)"; continue
      else displace "$dest"; fi
    fi
    if [ "$DRY" = 1 ]; then dry "cp agents/$n.md $dest"; continue; fi
    mkdir -p "$AGENTS_DIR"
    cp "$f" "$dest"
    state_set "agent:$n" "$(jq -n --arg p "$dest" --arg s "$sum" --arg t "$NOW" '{path:$p,sha256:$s,installed_at:$t}')"
    ok "$n: installed"
  done
}

# ======================================================================
# skills (pinned clones, copied subdir)
# ======================================================================
SKILL_NAMES=() ; while IFS= read -r n; do SKILL_NAMES+=("$n"); done < <(jq -r '.skills | keys[]' "$LOCK")
lockv() { jq -r --arg s "$1" --arg n "$2" --arg f "$3" '.[$s][$n][$f] // empty | if type == "array" then .[] else . end' "$LOCK"; }
skill_installed_commit() { if [ -f "$1/.SOURCE_COMMIT" ]; then head -n1 "$1/.SOURCE_COMMIT"; fi; }

stage_skill() { # <name> -> prints staged dir
  local n="$1" repo commit subdir note tmp out x
  repo="$(lockv skills "$n" repo)"; commit="$(lockv skills "$n" commit)"; subdir="$(lockv skills "$n" subdir)"; note="$(lockv skills "$n" source_note)"
  tmp="$(tmpdir)"
  clone_pinned "$repo" "$commit" "$tmp/src" >&2
  [ -f "$tmp/src/$subdir/SKILL.md" ] || die "$n: $subdir/SKILL.md not found at $commit"
  out="$tmp/out"
  cp -R "$tmp/src/$subdir" "$out"
  while IFS= read -r x; do
    if [ -n "$x" ] && [ ! -e "$out/$x" ]; then cp "$tmp/src/$x" "$out/$x"; fi
  done < <(lockv skills "$n" extra_files)
  printf '%s\n%s\ninstalled %s\n' "$commit" "${repo%.git}" "$NOW" >"$out/.SOURCE_COMMIT"
  if [ -n "$note" ]; then printf '%s\n' "$note" >"$out/SOURCE"; fi
  printf '%s' "$out"
}

install_skills() {
  head1 "skills → $SKILLS_DIR"
  local n dest commit out cur
  for n in ${SKILL_NAMES[@]+"${SKILL_NAMES[@]}"}; do
    dest="$SKILLS_DIR/$n"; commit="$(lockv skills "$n" commit)"
    if exists "$dest"; then
      if owned "skill:$n" && [ ! -L "$dest" ]; then
        cur="$(skill_installed_commit "$dest")"
        if [ "$cur" = "$commit" ]; then ok "$n: installed @ $(short "$cur") (pinned)"
        else skip "$n: installed @ $(short "$cur"), pinned $(short "$commit"): run 'overclock update'"; fi
        continue
      fi
      if [ "$REPLACE" = 0 ]; then skip "$n: skipped, $dest exists$([ -L "$dest" ] && echo " (symlink)") and is not managed by overclock (use --replace-foreign)"; continue; fi
    fi
    if [ "$DRY" = 1 ]; then
      if exists "$dest"; then displace "$dest"; fi
      dry "clone $(lockv skills "$n" repo) @ $(short "$commit"), copy $(lockv skills "$n" subdir) -> $dest"
      continue
    fi
    out="$(stage_skill "$n")"
    mkdir -p "$SKILLS_DIR"
    if exists "$dest"; then displace "$dest"; fi
    mv "$out" "$dest"
    state_set "skill:$n" "$(jq -n --arg p "$dest" --arg c "$commit" --arg t "$NOW" '{path:$p,commit:$c,installed_at:$t}')"
    ok "$n: installed @ $(short "$commit")"
  done
}

# ======================================================================
# context-mode MCP
# ======================================================================
CM_REPO="$(jq -r '.mcp["context-mode"].repo' "$LOCK")"
CM_COMMIT="$(jq -r '.mcp["context-mode"].commit' "$LOCK")"
mcp_entry() {
  jq -c --arg clone "$CM_DIR" --arg base "$BASE" '.mcpServers["context-mode"]
    | .args = ((.args // []) | map(split("@CLONE@") | join($clone) | split("@BASE@") | join($base)))
    | .env = ((.env // {}) | map_values(split("@CLONE@") | join($clone) | split("@BASE@") | join($base)))' "$MCP_TEMPLATE"
}

node_sqlite_ok() { # server.bundle.mjs is self-contained iff node:sqlite with FTS5 works (Node >= 22.5)
  node -e 'const {DatabaseSync}=require("node:sqlite");const d=new DatabaseSync(":memory:");d.exec("CREATE VIRTUAL TABLE t USING fts5(x)")' >/dev/null 2>&1
}

CM_OK=0
install_context_mode() {
  head1 "context-mode → $CM_DIR"
  if ! have node; then warn "context-mode: skipped, needs 'node' which is not installed"; return 0; fi
  if exists "$CM_DIR" && ! owned "mcp:context-mode" && origin_matches "$CM_DIR" "$CM_REPO" && is_pristine "$CM_DIR"; then
    if [ "$DRY" = 1 ]; then dry "adopt $CM_DIR (origin matches)"
    else state_set "mcp:context-mode" "$(jq -n --arg p "$CM_DIR" --arg c "$(head_of "$CM_DIR")" --arg t "$NOW" '{path:$p,commit:$c,installed_at:$t}')"; ok "adopted existing clone"; fi
    CM_OK=1
  fi
  if exists "$CM_DIR" && [ "$CM_OK" = 0 ]; then
    if owned "mcp:context-mode" && [ -d "$CM_DIR/.git" ] && [ ! -L "$CM_DIR" ]; then CM_OK=1
    elif [ "$REPLACE" = 0 ]; then skip "skipped, $CM_DIR exists and is not managed by overclock (use --replace-foreign)"; return 0
    fi
  fi
  if [ "$CM_OK" = 1 ]; then
    local cur; cur="$(head_of "$CM_DIR")"
    if [ "$cur" = "$CM_COMMIT" ]; then ok "installed @ $(short "$cur") (pinned)"
    else skip "installed @ $(short "$cur"), pinned $(short "$CM_COMMIT"): run 'overclock update'"; fi
  elif [ "$DRY" = 1 ]; then
    if exists "$CM_DIR"; then displace "$CM_DIR"; fi
    dry "clone $CM_REPO @ $(short "$CM_COMMIT") -> $CM_DIR"
    dry "mkdir -m 700 $BASE/context-mode $BASE/context-mode-shim"
    CM_OK=1
  else
    local tmp d; tmp="$(tmpdir)/cm"
    clone_pinned "$CM_REPO" "$CM_COMMIT" "$tmp"
    if exists "$CM_DIR"; then displace "$CM_DIR"; fi
    mv "$tmp" "$CM_DIR"
    state_set "mcp:context-mode" "$(jq -n --arg p "$CM_DIR" --arg c "$CM_COMMIT" --arg t "$NOW" '{path:$p,commit:$c,installed_at:$t}')"
    ok "cloned @ $(short "$CM_COMMIT")"
    for d in "$BASE/context-mode" "$BASE/context-mode-shim"; do [ -d "$d" ] || mkdir -m 700 -p "$d"; done
    CM_OK=1
  fi
  if ! node_sqlite_ok; then
    warn "context-mode: this node ($(node --version)) lacks node:sqlite+FTS5, so server.bundle.mjs falls back to better-sqlite3 from node_modules."
    warn "  overclock does not install npm deps. Run this yourself:"
    warn "    (cd \"$CM_DIR\" && npm install --omit=dev)"
    warn "  or upgrade to Node >= 22.5."
  fi
}

merge_mcp_json() {
  head1 "mcp.json → $MCP_FILE"
  [ "$CM_OK" = 1 ] || { skip "context-mode not installed; leaving mcp.json alone"; return 0; }
  if [ -L "$MCP_FILE" ]; then warn "$MCP_FILE is a symlink (Synaps refuses to read symlinked mcp.json); not touching it"; return 0; fi
  local cur want have_e new
  cur="$( [ -f "$MCP_FILE" ] && cat "$MCP_FILE" || echo '{}')"
  want="$(mcp_entry)"
  have_e="$(jq -c '.mcpServers["context-mode"] // empty' <<<"$cur")"
  if [ -n "$have_e" ]; then
    if [ "$(jq -S . <<<"$have_e")" = "$(jq -S . <<<"$want")" ]; then ok "context-mode: up to date"; return 0; fi
    if [ "$REPLACE" = 0 ]; then skip "context-mode: skipped, a different 'context-mode' server is already configured (use --replace-foreign)"; return 0; fi
  fi
  new="$(jq --argjson e "$want" '.mcpServers = ((.mcpServers // {}) + {"context-mode": $e})' <<<"$cur")"
  if [ "$DRY" = 1 ]; then dry "merge mcpServers.context-mode into $MCP_FILE (other servers preserved)"; return 0; fi
  backup_file "$MCP_FILE"
  if [ -n "$have_e" ]; then
    state_update '.displaced = ((.displaced // []) + [{mcp_file:$f, entry:$e, at:$t}])' --arg f "$MCP_FILE" --argjson e "$have_e" --arg t "$NOW"
  fi
  write_json "$MCP_FILE" "$new"
  ok "context-mode: added ($(jq '.mcpServers | length' <<<"$new") servers total)"
}

# ======================================================================
# status
# ======================================================================
cmd_status() {
  say "${C_B}synaps-overclocked status${C_0}  base=$BASE${PROFILE:+ profile=$PROFILE}"
  local n f dest c rec cur pin e
  head1 plugins
  for n in ${PLUGIN_NAMES[@]+"${PLUGIN_NAMES[@]}"}; do
    dest="$PLUGINS_DIR/$n"
    if ! exists "$dest"; then say "  $n: missing"; continue; fi
    if owned "plugin:$n" && managed_dir "$n" "$dest"; then
      c="$(plugin_commit "$n" "$dest")"
      rec="$( [ -f "$PSTATE" ] && jq -r --arg n "$n" '.installed[]? | select(.name == $n) | .installed_commit' "$PSTATE" 2>/dev/null || true)"
      e="unpinned, tracks HEAD"
      if [ -n "$(plugin_subdir "$n")" ]; then e="$(plugin_subdir "$n")/ of $(plugin_src "$n"), tracks HEAD"; fi
      if plugin_builds "$n"; then
        f="$(jq -r '.extension.command // empty' "$dest/.synaps-plugin/plugin.json" 2>/dev/null || true)"
        case "$f" in */*) if [ -x "$dest/$f" ]; then e="$e; built"; else e="$e; binary $f missing"; fi ;; esac
      fi
      say "  $n: installed @ $(short "$c") (plugins.json: $( [ -n "$rec" ] && short "$rec" || echo none); $e)"
    else
      say "  $n: skipped (foreign)$([ -L "$dest" ] && echo " symlink → $(readlink "$dest")")"
    fi
  done
  head1 agents
  for f in "$SELF_DIR"/agents/*.md; do
    n="$(basename "$f" .md)"; dest="$AGENTS_DIR/$n.md"
    if ! exists "$dest"; then say "  $n: missing"
    elif owned "agent:$n" && [ ! -L "$dest" ]; then
      if cmp -s "$f" "$dest"; then say "  $n: installed"; else say "  $n: installed (differs from repo)"; fi
    else say "  $n: skipped (foreign)"; fi
  done
  head1 skills
  for n in ${SKILL_NAMES[@]+"${SKILL_NAMES[@]}"}; do
    dest="$SKILLS_DIR/$n"; pin="$(lockv skills "$n" commit)"
    if ! exists "$dest"; then say "  $n: missing (pinned $(short "$pin"))"
    elif owned "skill:$n" && [ ! -L "$dest" ]; then
      cur="$(skill_installed_commit "$dest")"
      say "  $n: installed @ $(short "$cur") pinned $(short "$pin") $( [ "$cur" = "$pin" ] && echo "[ok]" || echo "[update available]")"
    else say "  $n: skipped (foreign)"; fi
  done
  head1 mcp
  if ! exists "$CM_DIR"; then say "  context-mode: missing (pinned $(short "$CM_COMMIT"))"
  elif owned "mcp:context-mode"; then
    cur="$(head_of "$CM_DIR")"
    say "  context-mode: installed @ $(short "$cur") pinned $(short "$CM_COMMIT") $( [ "$cur" = "$CM_COMMIT" ] && echo "[ok]" || echo "[update available]")"
  else say "  context-mode: skipped (foreign)"; fi
  e="$( [ -f "$MCP_FILE" ] && jq -c '.mcpServers["context-mode"] // empty' "$MCP_FILE" 2>/dev/null || true)"
  if [ -z "$e" ]; then say "  mcp.json context-mode: missing"
  elif [ "$(jq -S . <<<"$e")" = "$(mcp_entry | jq -S .)" ]; then say "  mcp.json context-mode: installed"
  else say "  mcp.json context-mode: skipped (foreign entry)"; fi
}

# ======================================================================
# update
# ======================================================================
# Subdir plugins have no .git: compare the recorded commit with upstream HEAD and
# restage the subdir if it moved. Local edits (content differs from what was
# recorded) block the update unless --reclone.
update_subdir_plugin() { # <name>
  local n="$1" dest="$PLUGINS_DIR/$1" src rec rec_tree head err
  src="$(plugin_src "$n")"
  rec="$(state_json | jq -r --arg k "plugin:$n" '.items[$k].commit // empty')"
  rec_tree="$(state_json | jq -r --arg k "plugin:$n" '.items[$k].tree // empty')"
  if [ -n "$rec_tree" ] && [ "$(tree_sum "$dest")" != "$rec_tree" ]; then
    if [ "$RECLONE" = 1 ]; then warn "$n: local changes; --reclone replaces it (old copy kept in backups)"; reclone_plugin "$n" || true
    else skip "$n: local changes, not updating (use --reclone to replace it)"; fi
    return 0
  fi
  if [ "$DRY" = 1 ]; then dry "git ls-remote $src HEAD; if it moved, copy $(plugin_subdir "$n")/ @ HEAD -> $dest (old copy to backups)"; return 0; fi
  if ! err="$(git ls-remote "$src" HEAD 2>&1)" || [ -z "$err" ]; then
    warn "$n: cannot reach $src: $(printf '%s' "$err" | tr '\n' ' ')"; return 0
  fi
  head="${err%%[[:space:]]*}"
  if [ "$head" = "$rec" ]; then ok "$n: up to date @ $(short "$rec")"; return 0; fi
  if reclone_plugin "$n"; then ok "$n: $(short "$rec") → $(short "$head")"; fi
}

cmd_update() {
  head1 "update plugins"
  local n dest before after err
  for n in ${PLUGIN_NAMES[@]+"${PLUGIN_NAMES[@]}"}; do
    dest="$PLUGINS_DIR/$n"
    if ! owned "plugin:$n" || ! managed_dir "$n" "$dest"; then skip "$n: not managed by overclock"; continue; fi
    OWNED_PLUGINS+=("$n")
    if [ -n "$(plugin_subdir "$n")" ]; then update_subdir_plugin "$n"; continue; fi
    if plugin_builds "$n" && ! have "$(plugin_needs "$n")"; then
      skip "$n: not updating, needs '$(plugin_needs "$n")' to rebuild it$(need_hint "$(plugin_needs "$n")")"; continue
    fi
    if is_dirty "$dest"; then
      if [ "$RECLONE" = 1 ]; then warn "$n: local changes; --reclone reclones it (old copy kept in backups)"; reclone_plugin "$n" || true
      else skip "$n: local changes, not updating (use --reclone to reclone)"; fi
      continue
    fi
    if [ "$DRY" = 1 ]; then
      dry "git -C $dest fetch origin && git merge --ff-only @{upstream}"
      if plugin_builds "$n"; then dry "(cd $dest && cargo build --release --locked) if it moved; on failure reset to the old commit"; fi
      continue
    fi
    before="$(head_of "$dest")"
    if ! err="$(git -C "$dest" fetch -q origin 2>&1 && git -C "$dest" merge -q --ff-only '@{upstream}' 2>&1)"; then
      err="$(printf '%s' "$err" | tr '\n' ' ')"
      if [ "$RECLONE" = 1 ]; then
        warn "$n: cannot fast-forward ($err); --reclone: recloning"
        reclone_plugin "$n" || true
      else
        warn "$n: cannot fast-forward, left at $(short "$before"): $err"
        warn "  upstream history was probably rewritten; 'overclock update --reclone' reclones it (old copy kept in backups)"
      fi
      continue
    fi
    after="$(head_of "$dest")"
    if [ "$before" = "$after" ]; then ok "$n: up to date @ $(short "$after")"; continue; fi
    if plugin_builds "$n"; then
      SETUP_LOG=""
      if ! build_plugin "$n" "$dest"; then
        git -C "$dest" reset -q --hard "$before"
        warn "$n: rebuild failed; source reset to $(short "$before"), the previous binary stays in place"
        continue
      fi
      state_merge "plugin:$n" "$(jq -cn --argjson st "$(setup_status_json)" '{setup_status:$st}')"
    fi
    ok "$n: $(short "$before") → $(short "$after")"
    state_merge "plugin:$n" "$(jq -n --arg c "$after" '{commit:$c}')"
    FRESH_PLUGINS+=("$n")
  done
  if [ "${#FRESH_PLUGINS[@]}" -gt 0 ]; then merge_plugins_json; fi

  head1 "update pinned skills"
  local pin cur out
  for n in ${SKILL_NAMES[@]+"${SKILL_NAMES[@]}"}; do
    dest="$SKILLS_DIR/$n"; pin="$(lockv skills "$n" commit)"
    if ! owned "skill:$n" || [ -L "$dest" ] || [ ! -d "$dest" ]; then skip "$n: not managed by overclock"; continue; fi
    cur="$(skill_installed_commit "$dest")"
    if [ "$cur" = "$pin" ]; then ok "$n: at pinned $(short "$pin")"; continue; fi
    if [ "$DRY" = 1 ]; then move_aside "$dest"; dry "install $n @ $(short "$pin") -> $dest"; continue; fi
    out="$(stage_skill "$n")"
    move_aside "$dest"
    mv "$out" "$dest"
    state_set "skill:$n" "$(jq -n --arg p "$dest" --arg c "$pin" --arg t "$NOW" '{path:$p,commit:$c,installed_at:$t}')"
    ok "$n: $(short "$cur") → $(short "$pin")"
  done

  head1 "update context-mode"
  if ! owned "mcp:context-mode" || [ -L "$CM_DIR" ] || [ ! -d "$CM_DIR/.git" ]; then skip "context-mode: not managed by overclock"; return 0; fi
  cur="$(head_of "$CM_DIR")"
  if [ "$cur" = "$CM_COMMIT" ]; then ok "context-mode: at pinned $(short "$CM_COMMIT")"; return 0; fi
  if is_dirty "$CM_DIR"; then skip "context-mode: local changes, not updating"; return 0; fi
  if [ "$DRY" = 1 ]; then dry "git -C $CM_DIR fetch --depth=1 origin $CM_COMMIT && checkout"; return 0; fi
  git -C "$CM_DIR" fetch -q --depth=1 origin "$CM_COMMIT"
  git -C "$CM_DIR" -c advice.detachedHead=false checkout -q FETCH_HEAD
  state_merge "mcp:context-mode" "$(jq -n --arg c "$CM_COMMIT" '{commit:$c}')"
  ok "context-mode: $(short "$cur") → $(short "$CM_COMMIT")"
}

# ======================================================================
# uninstall: move everything we own to $OC_DIR/removed/<ts>/ (outside every scanned tree)
# ======================================================================
cmd_uninstall() {
  local rm_root="$OC_DIR/removed/$TS" key p dest names=() new pj mj rp
  if exists "$rm_root"; then rm_root="$rm_root-$$"; fi
  head1 "uninstall → $rm_root"
  if [ ! -f "$OC_STATE" ]; then skip "nothing recorded in $OC_STATE; nothing to do"; return 0; fi
  # the plugins.json / mcp.json that install actually wrote (recorded profile wins over flags)
  rp="$(jq -r '.profile // empty' "$OC_STATE")"
  pj="$(jq -r --arg d "$PSTATE" '.plugins_json // $d' "$OC_STATE")"
  mj="$(jq -r --arg d "$MCP_FILE" '.mcp_json // $d' "$OC_STATE")"
  safe_path "$pj" || die "state.json records an unsafe plugins.json path: $pj"
  safe_path "$mj" || die "state.json records an unsafe mcp.json path: $mj"
  [ -n "$rp" ] && say "  using recorded profile '$rp' → $pj"
  if [ -f "$pj" ] && ! jq -e 'type == "object" and ((.installed // []) | type == "array")' "$pj" >/dev/null 2>&1; then
    die "$pj is not valid plugins.json; aborting without writing anything"
  fi

  # 1. move out what we installed
  while IFS=$'\t' read -r key p; do
    if [ -z "$p" ] || ! exists "$p"; then skip "$key: already gone"; continue; fi
    if ! safe_path "$p"; then warn "$key: recorded path $p is outside $BASE or has . / .. components; left alone"; continue; fi
    if [ -L "$p" ]; then skip "$key: $p is now a symlink, not ours; left alone"; continue; fi
    dest="$rm_root/$(rel_of "$p")"
    if [ "$DRY" = 1 ]; then dry "mv $p -> $dest"
    else mkdir -p "$(dirname "$dest")"; mv "$p" "$dest"; ok "$key: moved to $dest"; fi
    case "$key" in plugin:*) names+=("${key#plugin:}") ;; esac   # only items actually moved
  done < <(jq -r '.items | to_entries[] | [.key, (.value.path // "")] | @tsv' "$OC_STATE")

  # 2. plugins.json: only our marketplace's entries for moved plugins, plus what we added
  if [ -L "$pj" ]; then warn "$pj is a symlink; not editing it"
  elif [ -f "$pj" ]; then
    new="$(jq --argjson ns "$(printf '%s\n' ${names[@]+"${names[@]}"} | jq -R 'select(length > 0)' | jq -s .)" \
      --arg mn "$MARKETPLACE_NAME" --slurpfile st "$OC_STATE" '
      (if .installed then .installed |= map(select(.marketplace != $mn or (.name as $n | $ns | index($n) | not))) else . end)
      | (if ($st[0].added_marketplace // false) and .marketplaces and (any((.installed // [])[]; .marketplace == $mn) | not)
         then .marketplaces |= map(select(.name != $mn)) else . end)
      | ([(.installed // [])[] | .source_url | capture("^https://(?<h>[^/]+)/(?<o>[^/]+)/")? | "\(.h)/\(.o)"]) as $still
      | (if .trusted_hosts then .trusted_hosts |= map(select(. as $h | (($st[0].added_trusted_hosts // []) | index($h)) == null or ($still | index($h)) != null)) else . end)
      ' "$pj")"
    if [ "$(jq -S . "$pj")" != "$(jq -S . <<<"$new")" ]; then
      if [ "$DRY" = 1 ]; then dry "drop our entries [${names[*]+"${names[*]}"}] (and what overclock added) from $pj"
      else backup_file "$pj"; write_json "$pj" "$new"; ok "plugins.json: overclock's entries removed"; fi
    fi
  fi

  # 3. mcp.json: drop our entry, put back a displaced foreign one
  if [ -L "$mj" ]; then warn "$mj is a symlink; not editing it"
  elif [ -f "$mj" ]; then
    local cur prev
    cur="$(cat "$mj")"
    if [ "$(jq -cS '.mcpServers["context-mode"] // empty' <<<"$cur")" = "$(mcp_entry | jq -cS .)" ]; then
      cur="$(jq 'del(.mcpServers["context-mode"])' <<<"$cur")"
    fi
    prev="$(jq -c --arg f "$mj" '[(.displaced // [])[] | select(.mcp_file == $f)] | last | .entry // empty' "$OC_STATE")"
    if [ -n "$prev" ]; then
      if jq -e '.mcpServers["context-mode"] == null' <<<"$cur" >/dev/null; then
        cur="$(jq --argjson e "$prev" '.mcpServers["context-mode"] = $e' <<<"$cur")"
      else warn "mcp.json already has a context-mode entry; the one --replace-foreign displaced is in state.json"; fi
    fi
    if [ "$(jq -S . "$mj")" != "$(jq -S . <<<"$cur")" ]; then
      if [ "$DRY" = 1 ]; then dry "rewrite $mj: drop our context-mode entry${prev:+, restore the previous one}"
      else backup_file "$mj"; write_json "$mj" "$cur"; if [ -n "$prev" ]; then ok "mcp.json: previous context-mode entry restored"; else ok "mcp.json: context-mode removed"; fi; fi
    fi
  fi

  # 4. restore foreign items --replace-foreign displaced, only into empty spots
  local b l
  while IFS=$'\t' read -r p b l; do
    if ! safe_path "$p" || ! safe_path "$b"; then warn "displaced record $p <- $b is unsafe; left alone"; continue; fi
    if ! exists "$b"; then warn "displaced $p: backup $b is gone"; continue; fi
    if [ "$DRY" = 1 ]; then dry "restore $b -> $p (if $p is empty by then)"; continue; fi
    if exists "$p"; then warn "$p is occupied; your original stays at $b"; continue; fi
    mkdir -p "$(dirname "$p")"; mv "$b" "$p"
    ok "restored $p${l:+ (symlink → $l)}"
  done < <(jq -r '(.displaced // [])[] | select(.path) | [.path, .backup, (.link // "")] | @tsv' "$OC_STATE")

  if [ "$DRY" = 1 ]; then dry "mv $OC_STATE -> $rm_root/overclocked/state.json"
  else mkdir -p "$rm_root/overclocked"; mv "$OC_STATE" "$rm_root/overclocked/state.json"; fi
  say "  context-mode data dirs ($BASE/context-mode, $BASE/context-mode-shim) are left in place."
}

# ======================================================================
main() {
  case "$CMD" in
    status) cmd_status; return ;;
  esac
  say "${C_B}overclock $CMD${C_0}  base=$BASE${PROFILE:+ profile=$PROFILE}$([ "$DRY" = 1 ] && echo "  (dry run: nothing is written)")$([ "$RECLONE" = 1 ] && echo "  (--reclone)")$([ "$REPLACE" = 1 ] && echo "  (--replace-foreign)")"
  validate_json_files
  check_recorded_profile
  if [ "$DRY" = 0 ] && [ "$CMD" != uninstall ]; then init_tmp; fi
  case "$CMD" in
    install)
      check_runtimes
      install_plugins
      merge_plugins_json
      install_agents
      install_skills
      install_context_mode
      merge_mcp_json
      ;;
    update) cmd_update ;;
    uninstall) cmd_uninstall ;;
  esac
  say ""; say "done."
}
main
